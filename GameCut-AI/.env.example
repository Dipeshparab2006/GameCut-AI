# Copy to .env for a local PHP deployment, then replace every placeholder.
# Production environments should inject these values through their secret store
# rather than placing a .env file in the application directory.
GAMECUT_APP_ENV=development

# A dedicated, least-privilege database account is required. Do not use MySQL
# root and do not leave the production password empty.
GAMECUT_DB_HOST=127.0.0.1
GAMECUT_DB_PORT=3306
GAMECUT_DB_NAME=gamecut_ai
GAMECUT_DB_USER=gamecut_app
GAMECUT_DB_PASS=replace-with-a-local-secret

# Set an explicit canonical URL in production. Development may derive this
# from the current request when it is omitted.
# GAMECUT_SITE_URL=https://app.example.com
# GAMECUT_SITE_HOST=localhost:8080
# GAMECUT_BASE_PATH=/AI Video Editor/GameCut-AI

# Leave unset when the admin dashboard is not needed. This must contain real
# administrator account emails and has no built-in/demo fallback.
# GAMECUT_ADMIN_EMAILS=owner@example.com,operator@example.com

# Optional local-only tool URL. Do not expose phpMyAdmin through production.
# GAMECUT_PHPMYADMIN_URL=http://localhost/phpmyadmin/
